								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"+5511999999999\",\n  \"password\": \"Password123!\",\n  \"passwordConfirmation\": \"Password123!\"\n}"
