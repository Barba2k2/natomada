# ==========================================
# Application Configuration
# ==========================================
SPRING_PROFILES_ACTIVE=docker
NODE_ENV=development
APP_PORT=8080
API_URL=http://localhost:8080

# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_DB=na_tomada
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=
REDIS_PORT=6379

# ==========================================
# Kafka Configuration
# ==========================================
KAFKA_ENABLED=false
KAFKA_CONSUMER_GROUP=natomada-group

# ==========================================
# JPA Configuration
# ==========================================
SPRING_JPA_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=3600000
# Note: Spring Boot uses milliseconds, so 1h = 3600000ms

# ==========================================
# Refresh Token Configuration
# ==========================================
REFRESH_TOKEN_EXPIRES_IN=604800000
# Note: 7 days = 604800000ms

# ==========================================
# Email (SMTP) Configuration
# ==========================================
# Configure your SMTP provider credentials
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_EMAIL_FROM=noreply@yourdomain.com

# ==========================================
# SMS Configuration - Integraflux
# ==========================================
# Get your API token from: https://integraflux.apidocumentation.com/reference
SMS_INTEGRAFLUX_BASE_URL=https://sms.aresfun.com
SMS_INTEGRAFLUX_TOKEN=
SMS_INTEGRAFLUX_ENABLED=false

# ==========================================
# CORS Configuration
# ==========================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==========================================
# Trusted Proxies Configuration
# ==========================================
TRUSTED_PROXIES=

# ==========================================
# Security Headers Configuration
# ==========================================
# HSTS: Enable only when using HTTPS in production (forces HTTPS for all requests)
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# CSP: Configure based on your frontend requirements
SECURITY_CSP_ENABLED=false
SECURITY_CSP_POLICY=default-src 'self'

# ==========================================
# External APIs - OpenChargeMap
# ==========================================
# Get your API key at: https://openchargemap.org/site/develop/api
OPENCM_API_KEY=
OPENCM_BASE_URL=https://api.openchargemap.io/v3

# ==========================================
# External APIs - Google Places
# ==========================================
# Get your API key at: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
GOOGLE_PLACES_API_KEY=

# ==========================================
# AWS S3 Configuration
# ==========================================
# SECURITY: Use IAM roles in production instead of access keys
# If using access keys, create a dedicated IAM user with minimal permissions
# Get credentials from: https://console.aws.amazon.com/iam/
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==========================================
# Swagger / API Documentation
# ==========================================
# SECURITY: Disabled by default. Set to true only for development.
SWAGGER_ENABLED=false

# ==========================================
# Logging Configuration
# ==========================================
# SECURITY: Use INFO or WARN in production, DEBUG only for development
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO

# ==========================================
# Monitoring & Observability
# ==========================================
# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana Configuration
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# ==========================================
# In-App Purchase Configuration
# ==========================================
# Google Play Store
# Enable receipt verification (requires Google Play Developer API setup)
GOOGLE_PLAY_VERIFICATION_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.barbatech.natomada

# Apple App Store
# Enable receipt verification (requires App Store Server API setup)
APPLE_APP_STORE_VERIFICATION_ENABLED=false
# Get shared secret from App Store Connect > My Apps > [App] > App Information > App-Specific Shared Secret
APPLE_APP_STORE_SHARED_SECRET=
